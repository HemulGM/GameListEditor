  object Red_Help: TMemo
    Touch.InteractiveGestures = [Pan, LongTap, DoubleTap]
    Caret.Color = x00FFFFFF
    DataDetectorTypes = []
    Lines.Strings = (
      'Choose your folder:'
      'Select the folder where your systems folders are stored.'
      'It can be on your PC or on your Raspberry Pi.'
      ''
      
        'If you choose a folder on the Pi, you will be prompted with a me' +
        'ssage explaining that EmulationStation will be stopped in order ' +
        'to save your changes to the gamelist.xml.'
      
        'When you close the application, Recalbox/Retropie will be reboot' +
        'ed to reflect your changes.'
      ''
      'You have to check the box of a field to enable its modification.'
      
        'It is done on purpose, to avoid accidentally changing fields con' +
        'tent.'
      ''
      'Enable God Mode:'
      
        'Enabling this option will let you delete games directly from the' +
        ' application.'
      'A delete button will be added to the GUI.'
      
        'You will be prompted to confirm when you click on the delete but' +
        'ton.'
      
        'Deleting a game will remove its entry from the gamelist, delete ' +
        'the matching picture and video,and delete the file from your fol' +
        'der.'
      ''
      'Delete without prompt:'
      
        'Enabling this option will disable the prompt to confirm when you' +
        ' delete a game.'
      'Use with caution.'
      ''
      'Disable Pi prompts:'
      
        'Checking this option will disable all the prompts related to the' +
        ' EmulationStation stop and the Recalbox/Retropie reboot.'
      ''
      'Auto Hash:'
      
        'Enabling this option will Auto hash the files when you click on ' +
        'More Infos.'
      
        'Do this if you have a powerful computer or if your systems only ' +
        'contain small roms.'
      'Hashing files can be very slow so use it with caution.'
      
        'If you do not enable this option, you will be prompted to hash o' +
        'r not the file when you click on More Infos.'
      ''
      'Show tips at start:'
      
        'Enabling this option will show the help window on application st' +
        'art.'
      
        'You can disable the help window for the next launches, by disabl' +
        'ing this option or by checking the box "Don'#39't show again" in the' +
        ' help window, before closing it.'
      ''
      'Use Genesis logo:'
      
        'This will let you use the Genesis logo and name instead of Megad' +
        'rive.'
      ''
      'SSH / Configuration:'
      
        'Open a new popup window where you can set your Login and Passwor' +
        'd for Recalbox/Retropie.'
      
        'Filled with default values at first launch, your settings will b' +
        'e saved afterwards.'
      ''
      'System - Convert to lowercase:'
      
        'Will convert all the text to lowercase for the whole selected sy' +
        'stem (every game will be converted).'
      ''
      'System - Convert to uppercase:'
      
        'Will convert all the text to uppercase for the whole selected sy' +
        'stem (every game will be converted).'
      ''
      'System - Remove region from games names:'
      
        'Will remove the region tag in the name (i.e [xxxx]) for every ga' +
        'me of the selected system.'
      ''
      'System - Delete orphans from gamelist :'
      
        'Will remove from the gamelist.xml all the games that are not "ph' +
        'ysically" present on your drive.'
      
        'Orphan means the game is listed in the gamelist.xml, but the ass' +
        'ociated rom no longer exists.'
      ''
      'System - Delete duplicates from gamelist :'
      
        'Will remove all duplicates (same games that are listed 2 times o' +
        'r more) from the gamelist.xml'
      ''
      'Game - Convert to lowercase:'
      'Will convert all the text to lowercase for the selected game.'
      ''
      'Game - Convert to uppercase:'
      'Will convert all the text to uppercase for the selected game.'
      '')
    ReadOnly = True
    TextSettings.WordWrap = True
    Align = Client
    Cursor = crDefault
    Size.Width = 853.000000000000000000
    Size.Height = 450.000000000000000000
    Size.PlatformDefault = False
    StyleLookup = 'memostyle_clear'
    TabOrder = 0
    Visible = False
    Viewport.Width = 823.000000000000000000
    Viewport.Height = 438.000000000000000000
  end
